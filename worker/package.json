{
  "name": "sidekeys-proxy",
  "version": "0.1.0",
  "description": "Cloudflare Worker proxy for SideKeys: adds the Anthropic key, checks the Origin, limits requests per IP.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "check-key": "node check-key.mjs",
    "secret": "wrangler secret put ANTHROPIC_API_KEY"
  },
  "devDependencies": {
    "wrangler": "^4.134.0"
  },
  "license": "UNLICENSED"
}
