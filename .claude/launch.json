{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sidekeys",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        ".",
        "-l",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "sidekeys-shell",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "sidekeys-built",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
